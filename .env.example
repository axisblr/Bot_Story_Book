# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env.

# --- Telegram ---
BOT_TOKEN=
# Telegram ID админов через запятую (кому приходят заказы и статистика)
ADMIN_IDS=

# --- Google ---
# ID папки на Диске, внутри которой создаются папки заказов
MAIN_FOLDER_ID=
# ID Google-таблицы для строк заказов
SPREADSHEET_ID=

# --- Gemini (проверка качества фото) ---
GEMINI_API_KEY=
# Модель (по умолчанию gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# --- Пути (обычно менять не нужно) ---
# В Docker подставляется /app/data (том). Локально — ./data
# DATA_DIR=./data
# GOOGLE_CREDENTIALS_PATH=./data/credentials.json
# GOOGLE_TOKEN_PATH=./data/token.json

# Разрешить авторизацию Google через браузер.
# true — ТОЛЬКО локально, чтобы один раз получить token.json.
# На сервере всегда false: там браузера нет и бот бы завис.
ALLOW_INTERACTIVE_AUTH=false
